# KRIY web environment
# Copy to web/.env.local for local development. Configure the same names in Vercel.

# Public browser URL for the KRIY API. Do not include a trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only API URL used by the Next.js readiness route. In production this
# may be an internal/private service URL; otherwise use the public API URL.
API_BASE_URL=http://localhost:8000

# Must match GOOGLE_CLIENT_ID in the backend environment.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Development automation only. This value is embedded in browser JavaScript;
# never put a production or personal API key here.
NEXT_PUBLIC_API_KEY=

# Optional Google Analytics measurement ID (for example, G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=
