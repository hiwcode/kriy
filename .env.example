# KRIY backend environment
# Copy this file to .env for local development. Never deploy unchanged.

# Application
APP_NAME=KRIY
ENABLE_API_DOCS=true
APP_VERSION=0.1.0
DEBUG=False
ENVIRONMENT=development

# API / Auth
# Comma-separated global integration keys. Generate strong random values.
# Leave blank when using only Google sign-in and per-user API keys.
API_KEYS=
GOOGLE_CLIENT_ID=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_workflow_playground
# For Docker Compose, override with: postgresql://postgres:postgres@db:5432/ai_workflow_playground
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_workflow_playground
POSTGRES_PORT=5432

# Server
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000

# LLM providers (optional globally; users can save provider keys in KRIY)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gemini-3.1-flash-lite
# OLLAMA_API_BASE=http://localhost:11434

# Run safety and transient-error retries
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=1.0
LLM_MAX_CALLS_PER_RUN=500

# Tokenizer
TOKENIZER_MODEL=gpt-4o-mini
TOKENIZER_ENCODING=o200k_base

# Encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Session tokens (generate JWT_SECRET with: openssl rand -hex 32)
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=1440
REFRESH_TOKEN_TTL_DAYS=30

# Email tool safety (optional comma-separated recipient-domain allowlist)
EMAIL_ALLOWED_DOMAINS=

# Document Storage — DigitalOcean Spaces (optional — document upload disabled if not set)
SPACES_REGION=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_BUCKET=
SPACES_CDN_URL=

# Redis (optional — caching disabled if not set)
REDIS_URL=
# For Upstash: rediss://default:your-password@your-host.upstash.io:6379

# Database pool sizing
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=2

# Local development storage (ignored in production when object storage is used)
KRIY_STORAGE_DIR=./bucket
KRIY_WORKSPACE_DIR=./temp

# CORS
CORS_ORIGINS=["http://localhost:3004"]

# Logging
LOG_LEVEL=INFO
