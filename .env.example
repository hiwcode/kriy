# Application
APP_NAME=KRIY
ENABLE_API_DOCS=true
APP_VERSION=0.1.0
DEBUG=False
ENVIRONMENT=development

# API / Auth
API_KEYS=your-api-key-here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_workflow_playground
# For Docker Compose, override with: postgresql://postgres:postgres@db:5432/ai_workflow_playground
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_workflow_playground

# Server
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000

# LLM / Google AI
GOOGLE_API_KEY=your-google-api-key
DEFAULT_MODEL=ollama_chat/qwen3:8b
# OLLAMA_API_BASE=http://localhost:11434

# Tokenizer
TOKENIZER_MODEL=gpt-4o-mini
TOKENIZER_ENCODING=o200k_base

# Encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-fernet-encryption-key

# Session tokens
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=1440
REFRESH_TOKEN_TTL_DAYS=30

# Document Storage — DigitalOcean Spaces (optional — document upload disabled if not set)
SPACES_REGION=nyc3
SPACES_ACCESS_KEY=your-spaces-access-key
SPACES_SECRET_KEY=your-spaces-secret-key
SPACES_BUCKET=your-bucket-name
SPACES_CDN_URL=

# Redis (optional — caching disabled if not set)
REDIS_URL=redis://localhost:6379
# For Upstash: rediss://default:your-password@your-host.upstash.io:6379

# CORS
CORS_ORIGINS=["*"]

# Logging
LOG_LEVEL=INFO
