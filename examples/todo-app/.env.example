# Atelier integration (optional — the app runs fine without it; emit just no-ops).
# Copy to .env and fill in. When set, completing a todo emits a "todo.completed"
# event to Atelier, which runs whatever workflows you've defined for that event.
#
# Note: the app needs ONLY your API key — it identifies you, and your workflows
# (which event, which agent, what rule) live in Atelier, not in this app.

# A per-user API key from Atelier (Config → API key; starts with "ate-").
ATELIER_API_KEY=

# Optional: an agent id. Needed only for the BLOCKING guard on completion
# (guard("todo.complete", ...)) — it enforces that agent's deterministic policies,
# e.g. "deny todo.complete if name contains 'Standup'". Emit/events don't need it.
# ATELIER_AGENT_ID=3

# Backend URL (defaults to http://localhost:8000 if omitted).
# ATELIER_BASE_URL=http://localhost:8000

# Optional: scope events/workflows to a specific workspace (sent as X-Workspace-Id).
# Omit to use your personal workspace. Set this for a team workspace.
# ATELIER_WORKSPACE_ID=1
